DATABASE_URL="postgresql://postgres:postgres@localhost:5432/home_agent?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_TOKEN_SECRET="change-this-auth-token-secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-admin-password"

# 默认使用本地 Ollama（OpenAI 兼容接口）
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2"
OLLAMA_API_KEY="ollama"

# CI / 无模型服务时关闭 LLM 调用，回退规则规划器
# LLM_DISABLED="1"

# 若改用云端 OpenAI 兼容 API，设置 LLM_PROVIDER=openai 并填写：
# LLM_PROVIDER="openai"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY="your-api-key"
# OPENAI_MODEL="gpt-4o-mini"
