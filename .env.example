DATABASE_URL="postgresql://postgres:postgres@localhost:5432/home_agent?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 大风车 matador 分析库（MySQL，默认 test；需内网/VPN 访问 *.scsite.net）
# 密码只放本机 .env，不要提交到 Git
ANALYTICS_MYSQL_ENV=test
ANALYTICS_MYSQL_HOST=test.database3500.scsite.net
ANALYTICS_MYSQL_PORT=3500
ANALYTICS_MYSQL_DATABASE=matador
ANALYTICS_MYSQL_USER=souche_rw
ANALYTICS_MYSQL_PASSWORD=
ANALYTICS_MYSQL_SSL=false
ANALYTICS_MYSQL_CONNECT_TIMEOUT_MS=8000
ANALYTICS_MYSQL_QUERY_TIMEOUT_MS=15000
ANALYTICS_MYSQL_MAX_ROWS=500

# 默认使用本地 Ollama（OpenAI 兼容接口）
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2"
OLLAMA_API_KEY="ollama"

# CI / 无模型服务时关闭 LLM 调用，回退规则规划器
# LLM_DISABLED="1"

# Agent 循环最大步数（默认 4，上限 12）
# AGENT_MAX_STEPS="4"

# 若改用云端 OpenAI 兼容 API，设置 LLM_PROVIDER=openai 并填写：
# LLM_PROVIDER="openai"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY="your-api-key"
# OPENAI_MODEL="gpt-4o-mini"
