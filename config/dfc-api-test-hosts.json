{
  "comment": "测试环境 HTTP 根地址。默认 https://{app}.stable.dasouche.net（与内部 Swagger 一致；裸 {app}.dasouche.net 常 503）。apps 为探测确认的例外。skipHttpProbe：测试集群确认无 upstream 的服务。skipHttpProbeEndpoints：单接口长任务/全量初始化，探测会超时，勿当缺参修。",
  "defaultTemplate": "https://{app}.stable.dasouche.net",
  "apps": {
    "super-mario": "http://super-mario.stable.dasouche.net",
    "crazyracing-kartrider": "https://crazyracing-kartrider.stable.dasouche.net",
    "matador": "http://matador.dasouche.net",
    "ai-backend-algorithm": "https://ai-backend-algorithm.dasouche.net",
    "danube-admin-web": "https://danube-admin-web.dasouche-inc.net",
    "danube-plug-in-web": "https://danube-plug-in-web.dasouche.net",
    "ai-privacy-number": "https://ai-privacy-number.dasouche-inc.net"
  },
  "stripGatewayV1Prefix": ["danube-admin-web", "danube-plug-in-web"],
  "skipHttpProbe": ["cheniu-user", "customer-biz-data-system"],
  "skipHttpProbeEndpoints": [
    "matador:http:GET:/api/backup/idlefish/IdleFishBackupApi/initCarSourceDivision:initCarSourceDivision",
    "huaguo:http:GET:/bot-wall/v1/carDetailsApi/carDetailInfoV2.json:carDetailInfoV2Waf",
    "danube-authorization:http:GET:/duplicateV1/releaseWorkFlowByVersionIds:releaseWorkFlowByVersionIds",
    "danube-authorization:http:POST:/danubeAdmin/handleAllUserTool:handleAllUserTool",
    "danube-authorization:http:POST:/DataMigration/selectDeleteUser:selectDeleteUser",
    "danube-authorization:http:POST:/duplicateV1/deleteNotUsedTools:deleteNotUsedTools",
    "danube-authorization:http:POST:/duplicateV1/versionMetaDataOrgInit:versionMetaDataOrgInit"
  ]
}
