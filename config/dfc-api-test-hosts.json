{
  "comment": "测试环境 HTTP 根地址。默认 https://{app}.stable.dasouche.net（与内部 Swagger 一致；裸 {app}.dasouche.net 常 503）。apps 为探测确认的例外。skipHttpProbe：测试集群确认无 upstream 的服务。skipHttpProbeEndpoints：测试环境不宜 HTTP 探测的单接口（长任务/未注册 PATH_NOT_EXISTS/写操作等），勿当缺参修。",
  "defaultTemplate": "https://{app}.stable.dasouche.net",
  "apps": {
    "super-mario": "http://super-mario.stable.dasouche.net",
    "crazyracing-kartrider": "https://crazyracing-kartrider.stable.dasouche.net",
    "matador": "http://matador.dasouche.net",
    "ai-backend-algorithm": "https://ai-backend-algorithm.dasouche.net",
    "danube-admin-web": "https://danube-admin-web.dasouche-inc.net",
    "danube-plug-in-web": "https://danube-plug-in-web.dasouche.net",
    "ai-privacy-number": "https://ai-privacy-number.dasouche-inc.net"
  },
  "stripGatewayV1Prefix": ["danube-admin-web", "danube-plug-in-web"],
  "skipHttpProbe": [
    "cheniu-user",
    "customer-biz-data-system",
    "danube-megatron",
    "megatron"
  ],
  "skipHttpProbeEndpoints": [
