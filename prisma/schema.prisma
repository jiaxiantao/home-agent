generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  summary         String?
  contentMarkdown String   @db.Text
  tags            String[]
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished])
  @@index([updatedAt])
}

model IntelligenceProfile {
  id          String   @id @default(cuid())
  owner       String   @unique
  preferences Json
  learning    Json
  history     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
