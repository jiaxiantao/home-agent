NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 大风车分析库（MySQL，默认 test；需内网/VPN 访问 *.scsite.net）
# 同一实例上可跨库分析登记业务库（见 list_project_databases）；SQL 请用 `db`.`table`
# 生产请使用专用只读账号，勿用写权限账号
ANALYTICS_MYSQL_ENV=test
ANALYTICS_MYSQL_HOST=test.database3500.scsite.net
ANALYTICS_MYSQL_PORT=3500
ANALYTICS_MYSQL_DATABASE=matador
ANALYTICS_MYSQL_USER=souche_ro
ANALYTICS_MYSQL_PASSWORD=
ANALYTICS_MYSQL_SSL=false
ANALYTICS_MYSQL_CONNECT_TIMEOUT_MS=8000
ANALYTICS_MYSQL_QUERY_TIMEOUT_MS=15000
ANALYTICS_MYSQL_MAX_ROWS=500
# 允许分析的业务库（默认=项目登记库）。设为 * 可放开当前账号全部可见库
# ANALYTICS_MYSQL_DATABASE_ALLOWLIST=matador,danube_member,danube_topcars,danube_usedcar_market,danube_service_market,danube_mammon,danube_electronic_contract,danube_league,danube_deal_adapter,danube_statistics,super_mario,souche_dfc
# 多环境：声明可用 profile，默认用 ANALYTICS_MYSQL_* 作为当前 ANALYTICS_MYSQL_ENV
# ANALYTICS_MYSQL_PROFILES=test,prepub
# ANALYTICS_MYSQL_PREPUB_HOST=pre.database.scsite.net
# ANALYTICS_MYSQL_PREPUB_PORT=3500
# ANALYTICS_MYSQL_PREPUB_DATABASE=matador
# ANALYTICS_MYSQL_PREPUB_USER=souche_ro
# ANALYTICS_MYSQL_PREPUB_PASSWORD=
# 生产必填：允许 Agent 查询的表白名单（逗号分隔；跨库时仍按表名校验）
# ANALYTICS_MYSQL_TABLE_ALLOWLIST=car,car_extra,main_order,common_order,car_deal,buy_car,buy_call,operate_report

# —— 企业安全（内网部署）——
# 本地开发可 disabled；生产请 token 或 trusted_header
AUTH_MODE=disabled
# AUTH_MODE=token
# AUTH_TOKEN=change-me-to-long-random-string
# AUTH_DEFAULT_USER_ID=analyst001
# AUTH_DEFAULT_USER_NAME=内部分析师
# AUTH_TOKENS=userA:tokenA,userB:tokenB

# SSO 网关注入用户头（AUTH_MODE=trusted_header）
# AUTH_TRUSTED_USER_ID_HEADER=x-dfc-data-agent-user-id
# AUTH_TRUSTED_USER_NAME_HEADER=x-dfc-data-agent-user-name

# 多实例部署：Redis 持久化待确认 SQL（单实例可不配）
# REDIS_URL=redis://127.0.0.1:6379

# Agent API 每用户每分钟请求上限
# RATE_LIMIT_AGENT_PER_MIN=30

# —— 生产严格模式（见 docs/security.md）——
# PRODUCTION_STRICT=1
# REDIS_REQUIRED=1
# LLM_REQUIRE=1
# TRUSTED_PROXY_ONLY=1
# AUTH_ADMIN_USER_IDS=admin001
# ANALYTICS_MYSQL_EXPLAIN_GUARD=1
# ANALYTICS_MYSQL_EXPLAIN_MAX_ROWS=200000

# 审计推送到日志平台（可选 HTTP sink）
# AUDIT_HTTP_URL=https://logs.example.internal/ingest
# AUDIT_HTTP_TOKEN=replace-me

# 默认使用本地 Ollama（OpenAI 兼容接口）
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="qwen3"
OLLAMA_API_KEY="ollama"

# CI / 无模型服务时关闭 LLM 调用，回退规则规划器
# LLM_DISABLED="1"

# Agent 循环最大步数（默认 6，上限 12）
# AGENT_MAX_STEPS="6"

# 若改用云端 OpenAI 兼容 API，设置 LLM_PROVIDER=openai 并填写：
# LLM_PROVIDER="openai"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY="your-api-key"
# OPENAI_MODEL="gpt-4o-mini"
