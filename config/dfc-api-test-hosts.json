    "huaguo:http:GET:/bot-wall/v1/carDetailsApi/carDetailInfoV2.json:carDetailInfoV2Waf",
    "danube-authorization:http:GET:/duplicateV1/releaseWorkFlowByVersionIds:releaseWorkFlowByVersionIds",
    "danube-authorization:http:POST:/danubeAdmin/handleAllUserTool:handleAllUserTool",
    "danube-authorization:http:POST:/DataMigration/selectDeleteUser:selectDeleteUser",
    "danube-authorization:http:POST:/duplicateV1/deleteNotUsedTools:deleteNotUsedTools",
    "danube-authorization:http:POST:/duplicateV1/versionMetaDataOrgInit:versionMetaDataOrgInit",
    "crazyracing-kartrider:http:GET:/v1/grossProfit/getCarGrossProfit.json:getCarGrossProfit",
    "crazyracing-kartrider:http:GET:/v1/grossProfit/profitList/progress.json:profitListProgress",
    "crazyracing-kartrider:http:POST:/v1/grossProfit/profitList.json:profitList",
    "crazyracing-kartrider:http:POST:/v1/grossProfit/profitList/export.json:profitListExport",
    "crazyracing-kartrider:http:POST:/appbotwall/web/carCommand/createRecord:createRecordForApp",
    "crazyracing-kartrider:http:POST:/appbotwall/web/carCommand/modifyRecord:modifyRecordForApp",
    "crazyracing-kartrider:http:POST:/pcbotwall/web/carCommand/createRecord:createRecordForPc",
    "crazyracing-kartrider:http:POST:/pcbotwall/web/carCommand/modifyRecord:modifyRecordForPc",
    "crazyracing-kartrider:http:POST:/pcbotwall/web/v3/carViewQuery/queryRecordPageInfoForPc:queryRecordPageInfoForPcBot",
    "super-mario:http:GET:/customer/customerDetail/getCustomerIdByPhone:getCustomerIdByPhone"
  ]
}
