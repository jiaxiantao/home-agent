NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 大风车分析库（MySQL，默认 test；需内网/VPN 访问 *.scsite.net）
# 同一实例上可跨库分析登记业务库（见 list_project_databases）；SQL 请用 `db`.`table`
# 生产请使用专用只读账号，勿用写权限账号
ANALYTICS_MYSQL_ENV=test
ANALYTICS_MYSQL_HOST=test.database3500.scsite.net
ANALYTICS_MYSQL_PORT=3500
# 可选：MySQL 连接 bootstrap 库（不绑定 Agent 默认查询库；留空则按问题自动选库）
# ANALYTICS_MYSQL_DATABASE=
ANALYTICS_MYSQL_USER=souche_ro
ANALYTICS_MYSQL_PASSWORD=
ANALYTICS_MYSQL_SSL=false
ANALYTICS_MYSQL_CONNECT_TIMEOUT_MS=8000
ANALYTICS_MYSQL_QUERY_TIMEOUT_MS=15000
ANALYTICS_MYSQL_MAX_ROWS=500
# 允许分析的业务库（默认=项目登记 42 库，见 config/dbhub-dfc-sources.toml）。设为 * 可放开当前账号全部可见库
# ANALYTICS_MYSQL_DATABASE_ALLOWLIST=*
# 多环境：测试 / 预发 / 线上（三套 MySQL 实例，UI 可切换）
ANALYTICS_MYSQL_PROFILES=test,prepub,prod

# —— 测试（默认，与上方 ANALYTICS_MYSQL_* 一致时可省略 TEST_ 前缀）——
# ANALYTICS_MYSQL_TEST_HOST=test.database3500.scsite.net
# ANALYTICS_MYSQL_TEST_PORT=3500
# ANALYTICS_MYSQL_TEST_DATABASE=matador
# ANALYTICS_MYSQL_TEST_USER=souche_ro
# ANALYTICS_MYSQL_TEST_PASSWORD=

# —— 预发 ——
# 后端仓库通常不写 prepub JDBC（走 Apollo）。语雀示例见 docs/dfc-mysql-environments.md
# 常见：统一实例 pre.database3500.scsite.net:3500，或 RDS rm-bp*.mysql.rds.aliyuncs.com:3306
# ANALYTICS_MYSQL_PREPUB_HOST=
# ANALYTICS_MYSQL_PREPUB_PORT=3500
# ANALYTICS_MYSQL_PREPUB_DATABASE=matador
# ANALYTICS_MYSQL_PREPUB_USER=souche_ro
# ANALYTICS_MYSQL_PREPUB_PASSWORD=

# —— 线上（生产只读账号 + 严格表白名单）——
# 语雀 常见模式：RDS rm-bp*.mysql.rds.aliyuncs.com:3306（与测试 3500 多 schema 模型可能不同）
# 详见 docs/dfc-mysql-environments.md
# ANALYTICS_MYSQL_PROD_HOST=
# ANALYTICS_MYSQL_PROD_PORT=3306
# ANALYTICS_MYSQL_PROD_DATABASE=matador
# ANALYTICS_MYSQL_PROD_USER=souche_ro
# ANALYTICS_MYSQL_PROD_PASSWORD=
# 生产必填：允许 Agent 查询的表白名单（逗号分隔；跨库时仍按表名校验）
# ANALYTICS_MYSQL_TABLE_ALLOWLIST=car,car_extra,main_order,common_order,car_deal,buy_car,buy_call,operate_report

# —— 本地开发 · 直连测试环境 ——
# 本地建议 AUTH_MODE=disabled（跳过 SSO 网关）；接口 SSO 用 DFC_API_DEV_SSO_TOKEN
AUTH_MODE=disabled
# AUTH_MODE=sso

# 开启后端 HTTP 调用（测试环境）
DFC_API_ENABLED=1
# 登录 Mars 后 DevTools → Application → Cookies → _security_token 复制到此
# 或在侧栏「同步大风车登录」粘贴（会写入 _security_token Cookie，且优先于本项）
# DFC_API_DEV_SSO_TOKEN=
# DFC_SSO_USER_INFO_URL=https://sso.dasouche.net/api/user/query/findUserInfoByToken.json
# DFC_API_MATADOR_BASE_URL=https://matador.dasouche.net
# DFC_API_DEV_SSO_COOKIE=_security_token
# DFC_API_SERVICE_CHAIN=
# 测试环境必须用 *.dasouche.net；Agent 会拒绝调用线上 *.souche.com / *.souche-inc.com
# 与前端一致：CRM = http://super-mario.stable.dasouche.net（裸 super-mario.dasouche.net 常 503）
# DFC_API_SUPER_MARIO_BASE_URL=http://super-mario.stable.dasouche.net
# DFC_API_MATADOR_BASE_URL=http://matador.dasouche.net

# —— 企业安全（内网部署）——
# 本地开发可 disabled；生产请 sso / token / trusted_header
AUTH_MODE=disabled
# AUTH_MODE=sso
# DFC_MARS_ACCOUNT_URL=https://f2e.dasouche.net/projects/jupiter-f2e/mars_web_business/index.html#/login?action=accountLogin
# SSO_RETURN_PARAM=returnUrl
# SSO_COOKIE_NAMES=_security_token,_security_token_inc
# SSO_TOKEN_HEADERS=Souche-Security-Token,Souche-Security-Token-inc
# SSO_USER_ID_HEADER=x-souche-user-id
# SSO_USER_NAME_HEADER=x-souche-user-name

# AUTH_MODE=token
# AUTH_TOKEN=change-me-to-long-random-string
# AUTH_DEFAULT_USER_ID=analyst001
# AUTH_DEFAULT_USER_NAME=内部分析师
# AUTH_TOKENS=userA:tokenA,userB:tokenB

# SSO 网关注入用户头（AUTH_MODE=trusted_header）
# AUTH_TRUSTED_USER_ID_HEADER=x-dfc-data-agent-user-id
# AUTH_TRUSTED_USER_NAME_HEADER=x-dfc-data-agent-user-name

# 多实例部署：Redis 持久化待确认 SQL（单实例可不配）
# REDIS_URL=redis://127.0.0.1:6379

# Agent API 每用户每分钟请求上限
# RATE_LIMIT_AGENT_PER_MIN=30

# —— 生产严格模式（见 docs/security.md）——
# PRODUCTION_STRICT=1
# REDIS_REQUIRED=1
# LLM_REQUIRE=1
# TRUSTED_PROXY_ONLY=1
# AUTH_ADMIN_USER_IDS=admin001
# ANALYTICS_MYSQL_EXPLAIN_GUARD=1
# ANALYTICS_MYSQL_EXPLAIN_MAX_ROWS=200000

# 审计推送到日志平台（可选 HTTP sink）
# AUDIT_HTTP_URL=https://logs.example.internal/ingest
# AUDIT_HTTP_TOKEN=replace-me

# 默认使用本地 Ollama；UI「模型」下拉可切换，无需改 LLM_PROVIDER（请求级覆盖）
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="qwen3"
OLLAMA_API_KEY="ollama"

# —— 线上免费/低成本模型（OpenAI 兼容，注册后复制 API Key 到 .env）——
# Groq 免费：https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL="llama-3.3-70b-versatile"

# 硅基流动（国内，新用户赠额度）：https://cloud.siliconflow.cn/account/ak
# SILICONFLOW_API_KEY=
# SILICONFLOW_MODEL="Qwen/Qwen2.5-7B-Instruct"

# DeepSeek（新用户赠额度）：https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL="deepseek-chat"

# OpenRouter 免费模型路由：https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL="google/gemma-2-9b-it:free"

# OpenAI 官方（付费）
# OPENAI_API_KEY=
# OPENAI_MODEL="gpt-4o-mini"

# CI / 无模型服务时关闭 LLM 调用（问数会直接报错，不再回退规则规划器）
# LLM_DISABLED="1"

# —— 应用数据 MySQL（模板 / 收藏 / 历史 / 会话 / 待确认 SQL / 审计）——
# 与分析库 ANALYTICS_MYSQL_* 分离；未配置时回退 Redis / 内存
# APP_MYSQL_HOST=127.0.0.1
# APP_MYSQL_PORT=3306
# APP_MYSQL_USER=root
# APP_MYSQL_PASSWORD=123456
# APP_MYSQL_DATABASE=dfc_data_agent
# 初始化库表并导入 150+ 条团队问法：pnpm db:seed-templates

# Agent 循环最大步数（默认 6，上限 12）
# AGENT_MAX_STEPS="6"

# —— 大风车后端 HTTP 接口（可选）——
# 开启后，明细查询（如按客户 id / 手机号查客户）优先 call_backend_api，失败再 SQL
# DFC_API_ENABLED=1
# DFC_API_DEFAULT_SHOP_CODE=
# DFC_API_GATEWAY_BASE_URL=https://gateway-test.example.internal
# 测试环境 *.dasouche.net；与前端一致用 http + stable（裸 super-mario.dasouche.net 常 503）
# DFC_API_SUPER_MARIO_BASE_URL=http://super-mario.stable.dasouche.net
# DFC_API_MATADOR_BASE_URL=http://matador.dasouche.net
# DFC_API_DANUBE_MEMBER_BASE_URL=
# DFC_API_AUTH_TOKEN=
# 若 AUTH_MODE=sso，call_backend_api 会优先转发用户 SSO Cookie/Header；
# 本地开发时侧栏 _security_token 优先于 DFC_API_DEV_SSO_TOKEN
# DFC_API_SERVICE_CHAIN=
# DFC_API_TIMEOUT_MS=12000

# —— DFC API MCP 中间件（独立进程；LLM → MCP → 大风车，禁止默认跳过）——
# 默认开启 MCP；工具结果带 [via MCP 中间件]
# DFC_MCP_ENABLED=1
# 禁止本地绕过（默认 0）；仅排障可临时 =1
# DFC_MCP_FALLBACK_LOCAL=0
# Agent 默认 inprocess（同进程 MCP，可透传 Cookie SSO）；Cursor 用 stdio
# DFC_MCP_TRANSPORT=inprocess
# DFC_MCP_COMMAND=pnpm
# DFC_MCP_ARGS=exec tsx scripts/mcp-dfc-api/server.ts
# DFC_MCP_TIMEOUT_MS=20000
# 也可直接：pnpm mcp:dfc-api（供 Cursor 等 MCP 宿主连接）
